{
  "profile": "full",
  "plan_file": ".growing/plan.md",
  "archive_dir": ".growing/archive",
  "verify_default": "./scripts/verify.sh",
  "version_line_meta": "VERSION_LINE",
  "version_tag_glob_env": "VERSION_TAG_GLOB",
  "version_default_env": "RELEASE_VERSION_DEFAULT",
  "workflow": {
    "enabled": true,
    "hooks_enabled": true
  },
  "growth": {
    "enabled": true,
    "dir": ".growing",
    "learn_dir": "learn",
    "learn_sources": [
      "CHANGELOG.md",
      ".growing/archive/",
      ".growing/plan.md"
    ],
    "archive_flat_max": 5,
    "onekey_bootstrap": true
  },
  "release": {
    "enabled": true,
    "mode": "patch-per-task",
    "config": ".cursor/config/release.json"
  },
  "task_id": {
    "prefixes_autonomous": [
      "TASK-"
    ],
    "prefixes_skip": [
      "REV-",
      "SPIKE-",
      "DOC-"
    ]
  },
  "autonomous": {
    "default": true,
    "max_loops_default": 15,
    "confirm_before": [
      "high_risk_delete",
      "outside_repo"
    ],
    "interrupt_on": [
      "decision_needed",
      "blocker",
      "high_risk",
      "release",
      "goal_drift"
    ]
  },
  "role": {
    "default": "professional",
    "config": ".cursor/config/roles.json"
  },
  "followup_gate": {
    "enabled": true,
    "require_spike_after_patches": 2,
    "require_spike": false,
    "symptom_cluster_rules": [
      "async-progress.mdc",
      "long-running-ui.mdc",
      "modal-layering.mdc",
      "error-context.mdc",
      "single-detector.mdc"
    ]
  },
  "sdd": {
    "specs_dir": "docs/specs",
    "principles_file": "docs/principles.md",
    "feature_id_width": 3
  },
  "task_verify_heuristics": {
    "enabled": true,
    "fallback_test_script": "./scripts/test.sh",
    "fallback_verify_script": "./scripts/verify.sh",
    "frontend_test_dir": ".",
    "backend_test_dir": ".",
    "frontend_test_cmd": "npm run test",
    "backend_test_cmd": "pytest"
  },
  "temp_cleanup": {
    "enabled": true,
    "config": ".growing/temp-cleanup.json",
    "after_test": true,
    "after_verify": true,
    "after_task_verify": true,
    "sweep_after_verify": true,
    "dry_run": false
  }
}
